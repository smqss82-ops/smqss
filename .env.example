# Database (Railway injects these automatically; set manually for local dev)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=db

# TTS Voice (optional, defaults to en-KE-AsiliaNeural)
TTS_VOICE=en-KE-AsiliaNeural

# Email rating links (Brevo API; used to auto-email the rating URL on token issue)
BREVO_API_KEY=
EMAIL_FROM=SMQSS <smqss82@gmail.com>

# Public base URL for links in emails (e.g. https://yourdomain.com). Falls back to request host if empty.
PUBLIC_BASE_URL=
